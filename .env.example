# Скопируйте в .env.local для локальной разработки (в Vercel — переменные окружения в дашборде)

# Строка подключения Postgres (Neon / Vercel Postgres).
# Без неё приложение работает: расписание парсится on-the-fly, избранное — в localStorage.
# С ней добавляются: аккаунты, избранное в облаке, архив прошлых недель.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Секрет для подписи JWT-сессий.
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=длинная-случайная-строка

# Токен, которым Vercel Cron авторизуется на эндпоинте /api/cron/sync.
# Задаётся в Vercel: Settings → Environment Variables → CRON_SECRET.
# Vercel Cron автоматически отправляет его в заголовке Authorization с этим значением.
# Локально можно не задавать — эндпоинт будет открыт.
# CRON_SECRET=ещё-одна-случайная-строка
